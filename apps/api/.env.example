# PostgreSQL connection string for the dev database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/manual_trainer_dev

# PostgreSQL connection string for the test database
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/manual_trainer_test

# Secret key for signing JWTs. API exits if unset.
JWT_SECRET=your-secret-key-here

# JWT lifetime (e.g., 7d, 24h). Default: 7d
JWT_EXPIRES_IN=7d

# Set to production to enable secure cookies
NODE_ENV=development

# API listen port. Default: 3000
PORT=3000

# bcrypt work factor. Use 4 in tests for speed. Default: 12
BCRYPT_ROUNDS=12

# Max requests per window for auth endpoints. Default: 20
RATE_LIMIT_AUTH_MAX=20

# Rate limit window in ms (default 15 min). Default: 900000
RATE_LIMIT_AUTH_WINDOW_MS=900000

# Email for the initial admin account (seed script only)
ADMIN_EMAIL=

# Password for the initial admin account (seed script only)
ADMIN_PASSWORD=

# Review provider: local, openai, or anthropic. Default: openai or anthropic when a key is set, otherwise local.
REVIEW_PROVIDER=local

# Daily completed reviews per user. Admins are exempt. Default: 20
REVIEW_DAILY_LIMIT=20

# OpenAI. Used when REVIEW_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic. Used when REVIEW_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Required when the key is not scoped to one workspace. Example: wrkspc_01...
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-haiku-5-5

# Public origin of the API. Verification links in email use it.
# On Render leave API_ORIGIN, WEB_ORIGIN, and GOOGLE_REDIRECT_URI unset.
# The service uses RENDER_EXTERNAL_URL for all three.
API_ORIGIN=http://localhost:3000

# SMTP for registration emails. Without these, password registration cannot send a confirmation.
# Gmail: host smtp.gmail.com, port 587, user is the mailbox, password is an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Google sign-in. The redirect URI must be listed in the Google Cloud OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
WEB_ORIGIN=http://localhost:5173

